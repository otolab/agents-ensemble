{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node .cursor/hooks/deny-work-tools.mjs",
        "matcher": "Shell|Write|Edit|Delete|ApplyPatch|Task",
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/deny-work-tools.mjs",
        "failClosed": true
      }
    ]
  }
}
