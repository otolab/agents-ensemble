{
  "name": "agents-ensemble",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Issue-based agent orchestration (ensemble)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otolab/agents-ensemble.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc --build",
    "type-check": "tsc --build --emitDeclarationOnly",
    "ensemble": "node packages/cli/dist/index.js",
    "test": "pnpm --filter @agents-ensemble/core test",
    "test:run": "pnpm --filter @agents-ensemble/core test:run",
    "test:integration": "pnpm --filter @agents-ensemble/core test:integration",
    "test:e2e": "pnpm --filter @agents-ensemble/core test:e2e && pnpm --filter @agents-ensemble/cli test:e2e",
    "test:all": "pnpm test:run && pnpm test:integration && pnpm test:e2e"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
