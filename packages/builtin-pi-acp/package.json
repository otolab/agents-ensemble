{
  "name": "@agents-ensemble/builtin-pi-acp",
  "version": "0.1.0",
  "type": "module",
  "description": "Pi ACP adapter bundled with agents-ensemble",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pi-acp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:run": "node --import tsx --test test/**/*.test.ts",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test:run && pnpm run build"
  },
  "files": [
    "dist",
    "defaults",
    "LICENSE",
    "NOTICE",
    "README.md",
    "UPDATING.md"
  ],
  "dependencies": {
    "@agentclientprotocol/sdk": "0.26.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "tsx": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otolab/agents-ensemble.git",
    "directory": "packages/builtin-pi-acp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
