{
  "name": "@agents-ensemble/core",
  "version": "0.4.1",
  "type": "module",
  "description": "Core types and orchestration logic for agents-ensemble",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build && node scripts/copy-profiles.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:e2e": "vitest run --config vitest.config.e2e.ts",
    "prepublishOnly": "pnpm exec tsc --build --force && node scripts/copy-profiles.mjs"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otolab/agents-ensemble.git",
    "directory": "packages/core"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.27",
    "@modular-prompt/core": "0.3.0",
    "js-yaml": "4.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
