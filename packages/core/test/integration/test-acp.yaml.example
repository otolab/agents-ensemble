# integration / e2e 用 ACP 設定（コピーして test-acp.yaml として使う）
#
# cp test-acp.yaml.example test-acp.yaml

# agent バイナリ（省略時: PATH の agent）
# agentCommand: /Users/you/.local/bin/agent
# agentArgs: ["acp"]

# integration テストの cwd
cwd: /tmp

# e2e 共通（ensemble issue）
# issueUrl: https://github.com/otolab/agents-ensemble/issues/1
# repoRoot: /path/to/local/agents-ensemble-clone
# conductorCwd: /path/to/local/agents-ensemble-clone   # issue e2e 用（省略時 fixture）
# conductorModelId: auto   # team で composer-2.5 がブロックされる場合など
# profilePath: /absolute/path/to/e2e-smoke/profile.yaml  # issue e2e（省略時 smoke fixture）
