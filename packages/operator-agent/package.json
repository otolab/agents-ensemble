{
  "name": "@agents-ensemble/operator-agent",
  "version": "0.2.0",
  "type": "module",
  "description": "Embedded operator-role agent runtime for agents-ensemble",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
